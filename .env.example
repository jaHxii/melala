# ── Melala environment variables ──────────────────────────────
# Copy this file to `.env` and fill in the values.
#
# PUBLIC (safe to expose — they ship in the browser bundle):
#   Supabase project URL, e.g. https://xxxx.supabase.co
VITE_SUPABASE_URL=
# Supabase anon (publishable) key. Supabase RLS must block writes for anon.
VITE_SUPABASE_ANON_KEY=

# SECRET — ONLY used locally by the seed/migration script (scripts/seed-menu.ts).
# Never add this to the deployed app, Netlify build env, or any committed file.
VITE_SUPABASE_SERVICE_ROLE_KEY=
